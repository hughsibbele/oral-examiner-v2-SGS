# Oral Examiner v2 — env template
#
# This file is the CANONICAL source of truth for which env vars the app reads.
# If you add a new env var in code, add it here in the same PR. If you rename
# one on Vercel, rename it here too. Project policy: `.env.example` is
# canonical; Vercel and code conform to it.
#
# Local dev: copy this file to apps/teacher/.env.local and fill in values.
# Vercel:    set each var on the project's Settings → Environment Variables.


# ---- Supabase ---------------------------------------------------------------
# Project: oral-examiner-v2 (id: fxkorwqdibnukuernntq, region: us-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://fxkorwqdibnukuernntq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_4aHY4G0eMXiZRhk49pP8cA_pzmIomxU
# Server-only. Pull from Supabase dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=


# ---- Anonymizer salt (SHARED ECOSYSTEM-WIDE) -------------------------------
# Per integration-contract.md §2: this MUST be byte-identical across
# super-grader, AI Documenter v2, Handwritten Helper, Oral Examiner v2, and
# Harkness v2. All projects use this same var name.
# To set up: copy super-grader's value into here verbatim. Don't generate a
# new one — a fresh salt silently produces different anon_tokens, breaking
# cross-tool join keyed on the token.
SUPER_GRADER_SALT=


# ---- Canvas token at-rest encryption ---------------------------------------
# 32 random bytes, base64-encoded. Generate ONCE per project; rotation requires
# decrypting + re-encrypting every teachers.canvas_token_encrypted row.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CANVAS_TOKEN_ENC_KEY=


# ---- Admin bootstrap --------------------------------------------------------
# Email of the first admin. If the `admins` table is empty, this user gets
# auto-inserted on their first /admin visit. After bootstrap, additional
# admins are granted via /admin/admins by an existing admin.
INITIAL_ADMIN_EMAIL=
# Optional: only emails on this domain can be granted admin. Leave unset to
# allow any email an existing admin types.
ADMIN_EMAIL_DOMAIN=episcopalhighschool.org


# ---- Google OAuth -----------------------------------------------------------
# Create a Web OAuth client in https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://fxkorwqdibnukuernntq.supabase.co/auth/v1/callback
# Configure Supabase Auth → Providers → Google with these values.
# `hd` parameter is set in the sign-in call (see LoginForm), restricting to
# @episcopalhighschool.org Google Workspace.
# Scopes requested at sign-in: openid + email + profile + drive.file.
# `prompt=consent` forces Google to issue a refresh_token even when sibling
# suite apps on the same OAuth client already granted these scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---- Google Drive Picker (M2b.1f) -------------------------------------------
# Public-by-design — ships in the browser bundle (NEXT_PUBLIC_*).
#
# REQUIRED: NEXT_PUBLIC_GOOGLE_APP_ID is the Google Cloud project NUMBER (not
# its project-id slug). The Picker uses it to filter to files the drive.file
# scope authorizes for this app; without it, Drive API would 403 on the file
# IDs the Picker returns. Suite-converged client lives in project number
# `1064664034087`. No creation step in GCP — it's just a number.
NEXT_PUBLIC_GOOGLE_APP_ID=1064664034087
#
# OPTIONAL: NEXT_PUBLIC_GOOGLE_PICKER_API_KEY is a Google Cloud API key.
# Google's own "Create credentials" wizard for the Picker API states "This
# API doesn't require that you create credentials. You're already good to
# go!" — Picker works on the user's OAuth token alone. Setting this only
# attributes quota usage to the project (instead of a shared anonymous
# bucket); useful at scale, not needed for single-school operation. Leave
# blank to skip. If you set it later, restrict the key in GCP to: APIs →
# Drive API + Picker API; HTTP referrers → localhost + Vercel origins.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
#
# Optional override for the Gemini model used for PDF→text extraction in the
# intake pipeline. Falls back to gemini-2.5-flash. Use a higher-context model
# if intake PDFs run long, or swap to gemini-3.x when GA.
# GEMINI_PDF_MODEL=gemini-2.5-flash


# ---- Gemini -----------------------------------------------------------------
# Hugh's personal, EHS-paid key. Same value as in super-grader, AI Documenter,
# and Handwritten Helper — all projects use this same var name.
GEMINI_API_KEY=

# Per-teacher daily caps. Two buckets because Gemini Live (audio minutes) and
# Gemini Flash (text calls) are billed and capped independently. Both fail
# open on rate-limiter DB hiccup — better to over-serve a student mid-exam
# than block them on a glitch.
GEMINI_LIVE_DEFAULT_DAILY_CAP_MINUTES=120
GEMINI_TEXT_DEFAULT_DAILY_CAP=200

# Separate (tight) cap for admin "Try it out" dry-run sessions in /admin/agents.
# Lets admins test agents end-to-end without burning real-class budget.
GEMINI_LIVE_DRYRUN_DEFAULT_DAILY_CAP_MINUTES=15

# Gemini Live model. 3.1 Flash Live (March 2026) is the current top tier;
# same price as 2.5 Flash native audio, better quality, supports thinkingLevel.
# Override when Google ships a new generation or moves preview to GA.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview


# ---- Cron auth (Vercel scheduled functions, Phase 5) -----------------------
# Vercel automatically attaches `Authorization: Bearer ${CRON_SECRET}` to
# scheduled requests. The /api/cron/* routes verify this header.
# Generate: openssl rand -hex 32
CRON_SECRET=


# ---- Sentry (optional — leave blank to disable error reporting) ------------
SENTRY_DSN=
# Browser DSN — must be public-prefixed since it ships to the client bundle.
NEXT_PUBLIC_SENTRY_DSN=


# ---- App --------------------------------------------------------------------
# Public base URL — used in branded Canvas reflection card links + student
# exam URL composition. Local dev: http://localhost:3001 (super-grader takes
# 3000). When changing this for a new dev origin, also add it to the Supabase
# project's Auth → URL Configuration → Redirect URLs allowlist (AI Doc hit
# this — without the allowlist entry, OAuth falls back to Site URL on
# completion and the `next` param is dropped).
#
# Renamed from NEXT_PUBLIC_BASE_URL → NEXT_PUBLIC_APP_URL 2026-05-22 (M4.13
# harmonization — the rest of the suite uses NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_APP_URL=http://localhost:3001


# ---- Super-grader peer integration ==========================================
# Three secrets here are SHARED with super-grader — byte-identical values,
# but each side NAMES them after who it's talking to. Mapping:
#
#   OE v2's SUPER_GRADER_INGEST_TOKEN  ↔  super-grader's ORAL_EXAMINER_INGEST_TOKEN
#   OE v2's ORAL_EXAMINER_API_TOKEN    ↔  super-grader's ORAL_EXAMINER_API_TOKEN
#                                          (symmetric; same name both sides)
#   OE v2's SUPER_GRADER_API_URL       —  base URL of the super-grader deploy
#
# See planning/integration-contract.md §4 and BUILD_PLAN.md for the full
# token model.

# Bearer super-grader presents on inbound GET /api/super-grader/* requests.
# SHARED VALUE with super-grader (same var name on their side too).
# Generate fresh:  openssl rand -hex 32
# Leaving this blank → /api/super-grader/* routes return 500 (loud, so
# misconfig surfaces during initial setup rather than masquerading as a bad
# token).
ORAL_EXAMINER_API_TOKEN=

# Base URL of the super-grader deployment. Code appends /api/ingest/oral_examiner
# on outbound webhooks. When super-grader isn't deployed, leave blank — the
# webhook silently no-ops and the OE v2 student flow is unaffected.
SUPER_GRADER_API_URL=

# Bearer OE v2 presents on the outbound POST to
# <SUPER_GRADER_API_URL>/api/ingest/oral_examiner. SHARED VALUE with super-grader,
# where it's named ORAL_EXAMINER_INGEST_TOKEN (asymmetric naming on purpose:
# each side names after who it's authing TO).
SUPER_GRADER_INGEST_TOKEN=
